# Variables de entorno para el stack completo (docker-compose.yml en BACKEND/).
# Copia este archivo a ".env" y completa con tus propios valores.
# NUNCA comitees el ".env" real. En producción usa un secret manager.
# Generar secretos por ambiente con: openssl rand -base64 48 (JWT) / 24 (admin/bootstrap/internal)

# --- Base de datos ---
POSTGRES_DB=b2bmatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_bda_por_ambiente

# --- JWT (compartido por todos los microservicios) ---
JWT_SECRET=cambiar_jwt_secret_por_ambiente_mas_de_32_caracteres_minimo
JWT_EXPIRATION_MS=86400000

# --- Bootstrap de la cuenta admin (microservicio usuarios) ---
ADMIN_BOOTSTRAP_KEY=cambiar_admin_bootstrap_key_por_ambiente

# --- Comunicación entre microservicios (notificaciones) ---
INTERNAL_SERVICE_KEY=cambiar_internal_service_key_por_ambiente