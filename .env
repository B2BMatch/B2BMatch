# Variables de entorno para el stack completo (docker-compose.yml en la raíz).
# Copiar a ".env" (nunca comitear el .env real) y completar con valores propios.
# En producción estos valores deben venir de un secret manager, no de un archivo.

# --- Base de datos ---
POSTGRES_DB=b2bmatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# --- JWT (microservicio usuarios) ---
# Generar uno nuevo por ambiente, por ejemplo: openssl rand -base64 48
JWT_SECRET=sySQW5Jlo80o22DWtTfWB+LmQFx4vYpk6DovrKRWJZkNbmq2mumMLYwvKQDmM+e4
JWT_EXPIRATION_MS=86400000

# --- Bootstrap de la cuenta admin (microservicio usuarios) ---
# No hay registro público de ADMIN a propósito. Esta clave protege el único
# endpoint que puede crear una cuenta admin (POST /api/auth/register-admin,
# header X-Admin-Bootstrap-Key). Generar una nueva por ambiente, por ejemplo:
# openssl rand -base64 24
ADMIN_BOOTSTRAP_KEY=jwe80m0hmJLFdJL//MlvihUe+6QWorbt

# --- Comunicación entre microservicios (notificaciones) ---
# Clave compartida para que ofertas/resenias puedan crear notificaciones en
# nombre del sistema (POST /api/notifications/internal, header
# X-Internal-Service-Key). Generar una nueva por ambiente.
INTERNAL_SERVICE_KEY=M7laZBVU4zCNcUsDLKdlO4iM9/fmZu/K
